@page "/"
@page "/kits/{KitId}"

<header>
    <h1>Make your styleguide the default.</h1>
    <p>
        Remove the complexity of CSS-driven HTML by applying your KodeKit styles
        directly to the semantic HTML. No arbitrary classes, no confusion.
    </p>
    @if (Kit == null)
    {
        <button @onclick=Create>Start a new KodeKit</button>
    }
    else
    {
        <button @onclick=GoToMyKits>Go to My Kits</button>
    }
</header>

@if (Kit != null)
{
    <article>
        <section _="install FadeInOnScroll()">
            <header>
                <h4>What is KodeKit?</h4>
            </header>
            <p>
                KodeKit simplifies frontend development by allowing you to style HTML elements directly, without extra classes.
                Classes are only used for style variations and sizes. Plus, KodeKit is a visual theme builder, so you can create
                style guides and themes without writing any CSS.
            </p>
        </section>

        <section _="install FadeInOnScroll()">
            <header>
                <h4>How do I install KodeKit on my site?</h4>
            </header>
            <p>
                Simply add the following link to the <span>&lt;head&gt;</span> section of your site:
            </p>
            <div @onclick=CopyLink>
                <pre><code>@LinkUrl</code></pre>
                <aside>@ClickToCopy</aside>
            </div>
            <p>
                Or, just <a href="@ImportUrl" download="@ImportUrl" target="_blank">download the generated .css file directly</a>.
            </p>
        </section>
    </article>

    <section>
        <header>
            <h2>Overview</h2>
            <h3>Introduction</h3>
            <hr />
        </header>
    </section>
}

@inject IJSRuntime Js
@inject NavigationManager Nav
@inject KitApi Kits
@code
{
    [CascadingParameter] public Sparc.Blossom.Api.Kit Kit { get; set; } = default!;
    [CascadingParameter] public ClaimsPrincipal? User { get; set; }
    [Parameter] public string? KitId { get; set; }
    string ClickToCopy = "Click to copy";
    string ImportUrl => $"{Nav.BaseUri}{Kit?.Id}.css";
    string LinkUrl => $"<link rel=\"stylesheet\" href=\"{ImportUrl}\">";

    protected override async Task OnInitializedAsync()
    {
        if (Kit == null && User != null)
        {
            KitId ??= User.Get("CurrentKitId")
                  ?? (await Kits.All()).FirstOrDefault()?.KitId;

            if (KitId != null)
                Nav.NavigateTo($"/kits/{KitId}");
        }
    }

    async Task Create()
    {
        var kit = await Kits.Create("My First KodeKit", User!.Id());
        Nav.NavigateTo($"/kits/{kit.KitId}");
    }

    void GoToMyKits() => Nav.NavigateTo($"/kits");

    async Task CopyLink()
    {
        await Js.InvokeAsync<string>("copyToClipboard", LinkUrl);
        ClickToCopy = "Copied";
        await Task.Delay(2000);
        ClickToCopy = "Copy";
    }
}