@page "/"
@page "/kits/{kitId}/home"

<article>
    <header>
        <Preview>
            <Hero />
        </Preview>
    </header>

    @if (Kit != null)
    {
        <section _="install FadeInOnScroll()">
            <header>
                <h2>Overview</h2>
                <h3>Introduction</h3>
                <hr />
            </header>
            <header>
                <h4>What is KodeKit?</h4>
            </header>
            <p>
                KodeKit is a visual theme builder, so you can create
                style guides and themes without writing any CSS.
            </p>
            <p>
                KodeKit simplifies frontend development by allowing you to style base HTML 
                elements directly, without a slew of extra CSS classes. Classes are only used 
                for style variations--not the primary style.
            </p>
        </section>

        <section _="install FadeInOnScroll()">
            <header>
                <h4>How do I install KodeKit on my site?</h4>
            </header>
            <p>
                Simply add the following tag to the <span>&lt;head&gt;</span> section of your site:
            </p>
            <CodeBlock Code="@LinkUrl" CanCopy="true" />
            <p>
                Or, just <a href="@ImportUrl" download="@ImportUrl" target="_blank">download the generated .css file directly</a>.
            </p>
        </section>
    }
</article>

@inject IJSRuntime Js
@inject NavigationManager Nav
@inject KitApi Kits
@code
{
    [CascadingParameter] public Sparc.Blossom.Api.Kit Kit { get; set; } = default!;
    [CascadingParameter] public ClaimsPrincipal? User { get; set; }
    [Parameter] public string? kitId { get; set; }
    string ImportUrl => $"{Nav.BaseUri}{Kit?.Id}.css";
    string LinkUrl => $"<link rel=\"stylesheet\" href=\"{ImportUrl}\">";

    protected override async Task OnInitializedAsync()
    {
        if (Kit == null && User != null)
        {
            kitId ??= User.Get("CurrentKitId")
                  ?? (await Kits.All()).FirstOrDefault()?.KitId;

            if (kitId != null)
                Nav.NavigateTo($"/kits/{kitId}/home");
        }
    }
}