@inherits LayoutComponentBase

<BlobBackground ShowCursorShadow="false" />
@* <CustomCursor IsHomePage="false" />
 *@


<CascadingValue Value="User">
    <CascadingValue Value="Kit">
        <header>
            <NavMenu />
            <hr />
        </header>
        <main class="@(Kit == null ? "no-sidebar" : "")">
            @if (Kit != null)
            {
                <KitNavigation />
            }
            <div @ref=Main>
                @Body
            </div>
        </main>
    </CascadingValue>
</CascadingValue>

@inject IJSRuntime Js
@inject KitApi Kits
@inject AuthenticationStateProvider Auth
@code {
    ClaimsPrincipal? User { get; set; }
    Kit? Kit;
    ElementReference Main;

    protected override async Task OnParametersSetAsync()
    {
        object? kitId = null;
        if ((this.Body?.Target as RouteView)?.RouteData.RouteValues?.TryGetValue("kitId", out kitId) == true)
            Kit = await Kits.Get(kitId);

        var state = await Auth.GetAuthenticationStateAsync();
        User = state.User;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Js.InvokeVoidAsync("fadeBackgroundOnScroll", Main);

        await Js.InvokeVoidAsync("initHyperScript");
    }
}