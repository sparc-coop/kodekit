@inherits LayoutComponentBase

<CustomCursor />

<header>
    <NavMenu />
    <div class="divider"></div>
</header>

<CascadingValue Value="User">
    <CascadingValue Value="Kit">
        @if (Kit != null)
        {
            <KitNavigation />
        }
        <main class="@(Kit == null ? "no-sidebar" : "")">
            <div class="main__container">
                @Body
            </div>
        </main>
    </CascadingValue>
</CascadingValue>

@inject IJSRuntime Js
@inject KitApi Kits
@inject AuthenticationStateProvider Auth
@code {
    ClaimsPrincipal? User { get; set; }
    Kit? Kit;

    protected override async Task OnParametersSetAsync()
    {
        object? kitId = null;
        if ((this.Body?.Target as RouteView)?.RouteData.RouteValues?.TryGetValue("kitId", out kitId) == true)
            Kit = await Kits.Get(kitId);

        var state = await Auth.GetAuthenticationStateAsync();
        User = state.User;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Js.InvokeVoidAsync("initHyperScript");
    }
}