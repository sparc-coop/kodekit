@inherits LayoutComponentBase

<BlobBackground ShowCursorShadow="false" />
@* <CustomCursor IsHomePage="false" />
 *@


<CascadingValue Value="Kit">
    <header>
        <NavMenu />
        <hr />
    </header>
    <main class="@(Kit == null ? "no-sidebar" : "")">
        @if (Kit != null)
        {
            <KitNavigation />
        }
        <div @ref=Main>
            @Body
        </div>
    </main>
</CascadingValue>

@code {
    Kit? Kit;
    ElementReference Main;

    protected override async Task OnParametersSetAsync()
    {
        object? kitId = null;
        if ((this.Body?.Target as RouteView)?.RouteData.RouteValues?.TryGetValue("kitId", out kitId) == true)
            Kit = await Api.Kits.Get(kitId!);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Js.InvokeVoidAsync("fadeBackgroundOnScroll", Main);

        await Js.InvokeVoidAsync("initHyperScript");
    }
}