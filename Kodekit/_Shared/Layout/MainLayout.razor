@inherits LayoutComponentBase

<BlobBackground ShowCursorShadow="IsHomePage" />
<CustomCursor IsHomePage="@IsHomePage" />

<header>
    <NavMenu />
    @if (!IsHomePage)
    {
        <hr />
    }
</header>

<CascadingValue Value="User">
    <CascadingValue Value="Kit">
        <main class="@(Kit == null ? "no-sidebar" : "")">
            @if (Kit != null)
            {
                <KitNavigation />
            }
            <div>
                @Body
            </div>
        </main>
    </CascadingValue>
</CascadingValue>

@inject IJSRuntime Js
@inject KitApi Kits
@inject AuthenticationStateProvider Auth
@code {
    ClaimsPrincipal? User { get; set; }
    Kit? Kit;
    bool IsHomePage;

    protected override async Task OnParametersSetAsync()
    {
        IsHomePage = Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath == "/";

        object? kitId = null;
        if ((this.Body?.Target as RouteView)?.RouteData.RouteValues?.TryGetValue("kitId", out kitId) == true)
            Kit = await Kits.Get(kitId);

        var state = await Auth.GetAuthenticationStateAsync();
        User = state.User;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Js.InvokeVoidAsync("initHyperScript");
    }
}