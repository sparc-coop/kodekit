<nav class="hide-cursor-follow @Show">
    <header>Overview</header>
    <ul>
        <KitNavLink Name="Installation" Href="installation" />
    </ul>

    <header>Base Styles</header>
    <ul>
        <KitNavLink Name="Typography" Href="typography" Enabled="Kit.Current.Settings.UseTypography" />
        <KitNavLink Name="Colors" Href="colors" Enabled="Kit.Current.Settings.UseColors" />
        <KitNavLink Name="Icons" Href="icons" />
    </ul>

    <header>HTML Elements</header>
    <ul>
        <KitNavLink Name="Buttons" Href="buttons" Enabled="Kit.Current.Settings.UseButtons" />
        <KitNavLink Name="Inputs & Textareas" Href="inputs" Enabled="Kit.Current.Settings.UseInputs" />
        <KitNavLink Name="Selectors & Toggles" Href="selectors" Enabled="Kit.Current.Settings.UseInputs" />
        <KitNavLink Name="Dropdowns" Href="dropdowns" Enabled="Kit.Current.Settings.UseDropdowns" />
        <KitNavLink Name="Anchors" Href="anchors" Enabled="Kit.Current.Settings.UseAnchors" />
        <KitNavLink Name="Lists" Href="lists" Enabled="Kit.Current.Settings.UseLists" />
        <KitNavLink Name="Box Shadows" Href="box-shadow" Enabled="Kit.Current.Settings.UseShadows" />
    </ul>

    <header>Settings</header>
    <ul>
        <KitNavLink Name="Global Settings" Href="global-settings" />
    </ul>
</nav>

@code {
    string Show = "";

    [CascadingParameter] public Kit Kit { get; set; } = default!;
    private string Link(string page) => $"/{Kit.Id}/{page}";
}