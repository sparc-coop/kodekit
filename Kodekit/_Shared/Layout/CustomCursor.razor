<div id="cursor">
    @if (IsHomePage)
    {
        <img id="cursor-text" src="images/blobs/cursor-text.svg" />
    } 
    else
    {
        <div id="cursor-follow"></div>
    }
    <div id="cursor-point"></div>
</div>

@inject IJSRuntime Js
@code {
    [Parameter] public bool IsHomePage { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Js.InvokeVoidAsync("window.initCursor");
    }
}