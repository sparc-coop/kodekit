<div>
    <ColorSvg Hex=@Hex />
    <img class="shadow" src="/colors/Shadow.png" style="visibility: @(HideImages ? "hidden" : "visible")" />
    <img class="midtone" src="/colors/Midtone.png" style="visibility: @(HideImages ? "hidden" : "visible")" />
    <img class="highlight" src="/colors/Highlight.png" style="visibility: @(HideImages ? "hidden" : "visible")" />
</div>

@code {
    [Parameter] public string Hex { get; set; } = default!;
    [Parameter] public bool HideImages { get; set; }
}