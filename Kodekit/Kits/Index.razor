@page "/"
@layout NoSidebarLayout

<div class="main__container">
    <div class="page">
        <div class="page__container fadeInUp">
            @if (!IsLoading)
            {
                <header>
@*                     <p class="user">@User?.FirstName</p>
 *@                    <h2>My Kits</h2>
                    <p class="subheader">View and manage your kits for your projects.</p>
                    <div class="right">
                        @*                <select class="sort">
                    <option @onclick="@(e => Sort("date-mod"))">Recently Updated</option>
                    </select>*@
                        <AuthorizeView>
                            <Authorized>
                                <button @onclick="CreateNew">
                                    Add New Kit  +
                                </button>
                            </Authorized>
                            <NotAuthorized>
                                @if (UserKits == null || !UserKits.Any())
                                {
                                    <button @onclick="CreateNew">
                                        Add New Kit  +
                                    </button>
                                }
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </header>

                @if (UserKits == null || !UserKits.Any())
                {
                    <p>Create a new Kodekit to get started!</p>
                }
                else
                {
                    <div class="dashboard-container">
                        @foreach (var kit in UserKits)
                        {
                            <KitCard Kit="kit" />
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@inject IConfiguration Config
@inject KitApi Kits

@code {
    [CascadingParameter] public ClaimsPrincipal? User { get; set; }
    private IEnumerable<Kit> UserKits = [];
    bool IsLoading;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        UserKits = await Kits.All();
        IsLoading = false;
    }

    private async Task CreateNew()
    {
        var kit = await Kits.Create("Untitled Kit", User?.Id());
        GoToKit(kit.KitId);
    }

    private void Sort(string filter)
    {
        if (filter == "date-mod")
        {
            UserKits = UserKits.OrderByDescending(x => x.DateModified).ToList();
        }
    }

    private void GoToKit(string kit)
    {
        Nav.NavigateTo($"/{kit}/introduction");
    }
}