@rendermode @(new InteractiveServerRenderMode(prerender: false))
@page "/Projects"
@using static KodekitAPI.FigmaService
@inject FigmaService figmaService
@inject NavigationManager navigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Figma Projects</PageTitle>
<div>
    <input @bind="TeamId" />
    <label>Enter Team Id (tip: 1013945012488643266)</label>
    <button @onclick="GetProjectsInTeam">Submit</button>
</div>
@if (FigmaProjects.Any())
{
    @foreach (var project in FigmaProjects)
    {
        <div style="border-style: solid; border-width: 2px; border-color: red; padding-bottom: 30px">
            <h3>@project.Name</h3>
            @foreach (var file in project.Files)
            {
                <div @onclick="() => GoToStyles(file.Key)" style="border-style: solid; border-width: 2px; border-color: blue">
                    <div>@file.Name (@file.Key)</div>
                    <img style="max-width: 150px" src="@file.ThumbnailUrl" />
                </div>
            }
        </div>
    }
}
else
{
    <p>No files found.</p>
    
}


@code {
    // public List<FigmaFile> Files { get; set; } = new List<FigmaFile>();
    public List<Project> FigmaProjects { get; set; } = new List<Project>();
    public string TeamId { get; set; } = "";

    // protected override async Task OnInitializedAsync()
    // {

    // }
    public async Task<string> GetProjectsInTeam()
    {
        var token = await GetTokenAsync();
        FigmaProjects = await figmaService.GetProjectsInTeam(TeamId, token);
        foreach (var project in FigmaProjects)
        {
            // project.Files = new List<FigmaFile>();
            project.Files = await figmaService.GetFilesInProject(project.Id, token);
        }
        return "";
    }
    public async Task<string> GetTokenAsync()
    {
        var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
        // Use sessionStorage.getItem if you used sessionStorage to store the token
        return token;
    }
    public void GoToStyles(string id)
    {
        navigationManager.NavigateTo($"/styles/{id}", replace: true);
    }
}