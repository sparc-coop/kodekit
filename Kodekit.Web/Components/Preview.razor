@if (Kit != null)
{
    <div class="preview-example-container"
        _="on intersection(intersecting) having threshold 0.25
        if intersecting transition opacity to 1 then set :done to 1
        else if :done != 1 then transition opacity to 0">
        @if (HidePreviewBackgroundColor == false || HidePreviewFontColor == false)
        {
            <div class="preview-options">
                @if (HidePreviewBackgroundColor == false)
                {
                    <label class="preview-options--background">
                        <p>* Preview Background Color</p>
                        <InputColor @bind-Value="PreviewBackgroundColor" />
                        <aside class="swatch" style="background: @PreviewBackgroundColor;"></aside>
                    </label>
                }
                @if (HidePreviewFontColor == false)
                {
                    <label class="preview-options--font">
                        <p>Font Color</p>
                        <InputColor @bind-Value="PreviewFontColor" />
                        <aside class="swatch" style="background: @PreviewFontColor;"></aside>
                    </label>
                }
            </div>
        }
        @if (!IsLoading && CssUrl != null)
        {
            <style type="text/css">
                @@import url('@CssUrl');
            </style>

            <div class="preview-example @Scope @(AdditionalClass != null ? "preview-example--" + AdditionalClass : "")" @ref=PreviewBlock style="background: @PreviewBackgroundColor !important; color: @PreviewFontColor !important;">
                @ChildContent
            </div>
        }
        <div class="preview-info">
            * Using live generated CSS from <a class="preview-link" href="@CleanCssUrl" target="_blank">@CleanCssUrl</a>
        </div>
        <pre class="preview-code"
            _="on intersection(intersecting) having threshold 0.25
            if intersecting transition opacity to 1 then set :done to 1
            else if :done != 1 then transition opacity to 0">
            <code tabindex="0" class="language-html" @ref=CodeBlock>
            </code>
        </pre>
    </div>
}

@inject IConfiguration Config
@code {
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public Kit Kit { get; set; }
    [Parameter] public string AdditionalClass { get; set; }
    [Parameter] public bool HidePreviewBackgroundColor { get; set; } = false;
    [Parameter] public bool HidePreviewFontColor { get; set; } = false;
    ElementReference PreviewBlock;
    ElementReference CodeBlock;
    string CssUrl;
    string CleanCssUrl;
    string Scope;
    string CurrentVersion;
    bool IsLoading;
    string PreviewBackgroundColor = "#000000";
    string PreviewFontColor = "#FFFFFF";

    protected override void OnInitialized()
    {
        Scope = $"preview-{Guid.NewGuid()}";
    }

    protected override void OnParametersSet()
    {
        if (Kit == null) return;

        var newUrl = Config["ApiUrl"] + $"/{Kit.Id}.css?scope={Scope}&v={Kit.CurrentRevisionId}";
        Console.WriteLine("newurl " + newUrl);

        if (newUrl != CssUrl)
        {
            CssUrl = newUrl;
            Console.WriteLine("cssUrl " + CssUrl);

            CleanCssUrl = newUrl.Split("?")[0];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("populatePreviewCode", PreviewBlock, CodeBlock);
    }
}
