@inherits HighlightPageBase<ColorsModel>
@page "/{kitId}/colors"
@using Kodekit.Web.Components.Colors
@using Kodekit.Features;
@using System.Drawing;

<div class="colors page">
    <div class="page__container fadeInUp">
        <header class="page--header">
            <div class="title">Base Styles</div>
            <h2>Colors</h2>
            <p>
                Colors selected here will be applied throughout the kit. They will be
                applied to their respective elements (such as primary and secondary buttons)
                &amp; system colors, as well as accessed via css variables.
            </p>
        </header>
        <div class="content">
            <!-- Contrast Checker Component Here -->
            @if (Model != null)
            {
                <EditForm EditContext="@Context">
                    <KitStyle Kit=kit>
                        <section class="colors--brand"
                                 _="on intersection(intersecting) having threshold 0.25
                               if intersecting transition opacity to 1 then set :done to 1
                               else if :done != 1 then transition opacity to 0">
                            <header class="flex">
                                <div class="header__container">
                                    <h3><span>01</span> Brand Colors</h3>
                                    <p class="subheader">
                                        The brand colors are the three main colors that will be used to accent your site.
                                    </p>
                                </div>
                                <img class="collapse-btn" src="images/collapse-icon.svg" 
                                _="on click toggle .collapsed on next <div/> then toggle .collapsed on me" />
                            </header>
                            <div class="collapsible">
                                <div class="color-display primary"
                                     _="on intersection(intersecting) having threshold 0.25
                                        if intersecting transition opacity to 1 then set :done to 1
                                        else if :done != 1 then transition opacity to 0">
                                    <div class="color-main">
                                        <label class="edit-color">
                                            @if (string.IsNullOrEmpty(Model.Primary))
                                            {
                                                <ColorCardPlaceholder Weight="Primary" />
                                            }
                                            else
                                            {
                                                <ColorCard Type="Primary" Weight="Primary" Hex="@Model.Primary" />
                                            }
                                            <InputColor @bind-Value="Model.Primary" />
                                        </label>
                                    </div>
                                    <div class="subcolor-display">
                                        @foreach (var weight in Weights)
                                        {
                                            string hex = PrimaryColors[$"primary-{weight}"];
                                            @if (hex == null)
                                            {
                                                hex = "primary-" + weight;
                                            }
                                            @if (string.IsNullOrEmpty(Model.Primary))
                                            {
                                                <ColorCardPlaceholder Weight="@weight" />
                                            }
                                            else
                                            {
                                                <ColorCard Type="Primary" Weight="@weight" Hex="@hex" />
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="color-display secondary"
                                     _="on intersection(intersecting) having threshold 0.25
                                       if intersecting transition opacity to 1 then set :done to 1
                                       else if :done != 1 then transition opacity to 0">
                                    <div class="color-main">
                                        <label class="edit-color">
                                            @if (string.IsNullOrEmpty(Model.Secondary))
                                            {
                                                <ColorCardPlaceholder Weight="Secondary" />
                                            }
                                            else
                                            {
                                                <ColorCard Type="Secondary" Weight="Secondary" Hex="secondary-500" />
                                            }
                                            <InputColor @bind-Value="Model.Secondary" />
                                        </label>
                                    </div>
                                    <div class="subcolor-display">
                                        @foreach (var weight in Weights)
                                        {
                                            string hex = SecondaryColors[$"secondary-{weight}"];
                                            @if (hex == null)
                                            {
                                                hex = "secondary-" + weight;
                                            }
                                            @if (string.IsNullOrEmpty(Model.Secondary))
                                            {
                                                <ColorCardPlaceholder Weight="@weight" />
                                            }
                                            else
                                            {
                                                <ColorCard Type="Secondary" Weight="@weight" Hex="@hex" />
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="color-display tertiary" 
                                    _="on intersection(intersecting) having threshold 0.25
                                       if intersecting transition opacity to 1 then set :done to 1
                                       else if :done != 1 then transition opacity to 0">
                                    <div class="color-main">
                                        <label class="edit-color">
                                            @if (string.IsNullOrEmpty(Model.Tertiary))
                                            {
                                                <ColorCardPlaceholder Weight="Tertiary" />
                                            }
                                            else
                                            {
                                                <ColorCard Type="Tertiary" Weight="Tertiary" Hex="tertiary-500" />
                                            }
                                            <InputColor @bind-Value="Model.Tertiary" />
                                        </label>
                                    </div>
                                    <div class="subcolor-display">
                                        @foreach (var weight in Weights)
                                        {
                                            string hex = TertiaryColors[$"tertiary-{weight}"];
                                            @if (hex == null)
                                            {
                                                hex = "tertiary-" + weight;
                                            }
                                            @if (string.IsNullOrEmpty(Model.Tertiary))
                                            {
                                                <ColorCardPlaceholder Weight="@weight" />
                                            }
                                            else
                                            {
                                                <ColorCard Type="Tertiary" Weight="@weight" Hex="@hex" />
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="colors--greyscale"
                            _="on intersection(intersecting) having threshold 0.25
                               if intersecting transition opacity to 1 then set :done to 1
                               else if :done != 1 then transition opacity to 0">
                            <header class="flex">
                                <div class="header__container">
                                    <h3><span>02</span> Greyscale</h3>
                                    <p class="subheader">
                                    The greyscale colors will primarily be used for text.
                                    </p>
                                </div>
                                <img class="collapse-btn" src="images/collapse-icon.svg"
                                     _="on click toggle .collapsed on next <div/> then toggle .collapsed on me" />
                            </header>
                            <div class="color-display greyscale collapsible">
                                <div class="color-main">
                                    <label class="edit-color">
                                        @if (string.IsNullOrEmpty(Model.Lightest))
                                        {
                                            <ColorCardPlaceholder Weight="Lightest" />
                                        }
                                        else
                                        {
                                            <ColorCard Type="Lightest" Weight="Lightest" Hex="grey-100" />
                                        }
                                        <InputColor @bind-Value="Model.Lightest" />
                                    </label>
                                    <label class="edit-color">
                                        @if (string.IsNullOrEmpty(Model.Darkest))
                                        {
                                            <ColorCardPlaceholder Weight="Darkest" />
                                        }
                                        else
                                        {
                                            <ColorCard Type="Darkest" Weight="Darkest" Hex="grey-900" />
                                        }
                                        <InputColor @bind-Value="Model.Darkest" />
                                    </label>
                                </div>
                                <div class="subcolor-display">
                                    @foreach (var weight in Weights)
                                    {
                                        string hex = GreyscaleColors[$"grey-{weight}"];
                                        @if (hex == null)
                                        {
                                            hex = "grey-" + weight;
                                        }
                                        @if (string.IsNullOrEmpty(Model.Lightest) || string.IsNullOrEmpty(Model.Darkest))
                                        {
                                            <ColorCardPlaceholder Weight="@weight" />
                                        }
                                        else
                                        {
                                            <ColorCard Type="Grey" Weight="@weight" Hex="@hex" />
                                        }
                                    }
                                </div>
                            </div>
                        </section>
                        <section class="colors--system"
                            _="on intersection(intersecting) having threshold 0.25
                               if intersecting transition opacity to 1 then set :done to 1
                               else if :done != 1 then transition opacity to 0">
                            <header class="flex">
                                <div class="header__container">
                                    <h3><span>03</span> System Colors</h3>
                                    <p class="subheader">
                                        The system colors are used to highlight alerts.
                                    </p>
                                </div>
                                <img class="collapse-btn" src="images/collapse-icon.svg"
                                     _="on click toggle .collapsed on next <div/> then toggle .collapsed on me" />
                            </header>
                            <div class="color-display collapsible">
                                <label class="edit-color">
                                    @if (string.IsNullOrEmpty(Model.Error))
                                    {
                                        <ColorCardPlaceholder Weight="Error" />
                                    }
                                    else
                                    {
                                        <ColorCard Type="Error" Weight="Error" Hex="error-500" />
                                    }
                                    <InputColor @bind-Value="Model.Error" />
                                </label>
                                <label class="edit-color">
                                    @if (string.IsNullOrEmpty(Model.Warning))
                                    {
                                        <ColorCardPlaceholder Weight="Warning" />
                                    }
                                    else
                                    {
                                        <ColorCard Type="Warning" Weight="Warning" Hex="warning-500" />
                                    }
                                    <InputColor @bind-Value="Model.Warning" />
                                </label>
                                <label class="edit-color">
                                    @if (string.IsNullOrEmpty(Model.Success))
                                    {
                                        <ColorCardPlaceholder Weight="Success" />
                                    }
                                    else
                                    {
                                        <ColorCard Type="Success" Weight="Success" Hex="success-500" />
                                    }
                                    <InputColor @bind-Value="Model.Success" />
                                </label>
                            </div>
                        </section>
                        <section class="colors--preview"
                            _="on intersection(intersecting) having threshold 0.25
                               if intersecting transition opacity to 1 then set :done to 1
                               else if :done != 1 then transition opacity to 0">
                            <header class="flex">
                                <div class="header__container">
                                    <h3><span>04</span> Preview</h3>
                                    <p class="subheader">A small example of all colors, buttons, and typography applied to two cards.</p>
                                </div>
                                <img class="collapse-btn" src="images/collapse-icon.svg"
                                     _="on click toggle .collapsed on next <div/> then toggle .collapsed on me" />
                            </header>
                            <div class="colors--preview__container collapsible">
                                <div class="preview-background">
                                    <p>* Preview Background Color</p>
                                    <InputColor @bind-Value="PreviewBackgroundColor" />
                                    <aside class="swatch" style="background: @PreviewBackgroundColor;"></aside>
                                </div>
                                <div class="preview-cards">
                                    <div class="card-with-image" style="background: @PreviewBackgroundColor">
                                        <ColorPreview Primary="@Model.Primary" Secondary="@Model.Secondary" Tertiary="@Model.Tertiary" />
                                        <div class="card-content">
                                            <h6 class="tertiary">Information</h6>
                                            <h4>Brand Colors</h4>
                                            <p>
                                                Lorem ipsum dolor sit amet, consectetuer adipiscing elit
                                            </p>
                                            <button>Primary CTA</button>
                                        </div>
                                    </div>
                                    <div class="card" style="background: @PreviewBackgroundColor">
                                        <div class="card-content">
                                            <h6 class="tertiary">Information</h6>
                                            <h4>Brand Colors</h4>
                                            <p>
                                                Lorem ipsum dolor sit amet, consectetuer adipiscing elit
                                            </p>
                                            <div class="buttons">
                                                <button>Primary CTA</button>
                                                <button class="secondary">Secondary CTA</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </KitStyle>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    List<string> Weights = new List<string> { "50", "100", "200", "300", "400", "500", "600", "700", "800", "900" };
    Dictionary<string, string> PrimaryColors;
    Dictionary<string, string> SecondaryColors;
    Dictionary<string, string> TertiaryColors;
    Dictionary<string, string> GreyscaleColors;
    string PreviewBackgroundColor = "#000000";

    protected override async Task OnInitializedAsync()
    {
        DebounceInputs = true;
        await base.OnInitializedAsync();

        if (Model != null)
        {
            PrimaryColors = Serialize("primary", Model.Primary);
            SecondaryColors = Serialize("secondary", Model.Secondary);
            TertiaryColors = Serialize("tertiary", Model.Tertiary);
            GreyscaleColors = Expand(Model.Lightest, Model.Darkest);
        }
    }

    protected override async Task<ColorsModel> GetAsync()
    {
        return await PublicApi().GetColorsAsync(kitId);
    }

    protected override async Task<Kit> UpdateAsync()
    {
        return await PublicApi().UpdateColorsAsync(Model);
    }


    public Dictionary<string, string> Serialize(string? type, string hex)
    {
        if (!string.IsNullOrWhiteSpace(type))
            type = type.ToLower();
        else
            type = string.Empty;

        return new Dictionary<string, string>
        {
            { $"{type}-50", ChangeBrightness(0.52f, hex) },
            { $"{type}-100", ChangeBrightness(0.37f, hex) },
            { $"{type}-200", ChangeBrightness(0.26f, hex) },
            { $"{type}-300", ChangeBrightness(0.12f, hex) },
            { $"{type}-400", ChangeBrightness(0.06f, hex) },
            { $"{type}-500", hex },
            { $"{type}-600", ChangeBrightness(-0.06f, hex) },
            { $"{type}-700", ChangeBrightness(-0.12f, hex) },
            { $"{type}-800", ChangeBrightness(-0.18f, hex) },
            { $"{type}-900", ChangeBrightness(-0.24f, hex) }
        };
    }

    public Dictionary<string, string> Expand(string lightest, string darkest)
    {
        var type = "grey";
        var colors = new Dictionary<string, string>();

        colors.Add($"{type}-50", Interpolate(lightest, darkest, 0.05f));

        for (var i = 0.1f; i < 1f; i += 0.1f)
            colors.Add($"{type}-{Math.Round(i * 1000)}", Interpolate(lightest, darkest, i));

        return colors;
    }

    private string ChangeBrightness(float correctionFactor, string hex)
    {
        var color = ColorTranslator.FromHtml(hex);

        float red = color.R;
        float green = color.G;
        float blue = color.B;

        if (correctionFactor < 0)
        {
            correctionFactor = 1 + correctionFactor;
            red *= correctionFactor;
            green *= correctionFactor;
            blue *= correctionFactor;
        }
        else
        {
            red = (255 - red) * correctionFactor + red;
            green = (255 - green) * correctionFactor + green;
            blue = (255 - blue) * correctionFactor + blue;
        }

        color = System.Drawing.Color.FromArgb(color.A, (int)red, (int)green, (int)blue);
        return ColorTranslator.ToHtml(color);
    }

    public string Interpolate(string lightest, string darkest, float percentage)
    {
        var color1 = ColorTranslator.FromHtml(lightest);
        var color2 = ColorTranslator.FromHtml(darkest);

        double resultRed = color1.R + percentage * (color2.R - color1.R);
        double resultGreen = color1.G + percentage * (color2.G - color1.G);
        double resultBlue = color1.B + percentage * (color2.B - color1.B);

        var color = System.Drawing.Color.FromArgb((int)resultRed, (int)resultGreen, (int)resultBlue);

        return ColorTranslator.ToHtml(color);
    }
}