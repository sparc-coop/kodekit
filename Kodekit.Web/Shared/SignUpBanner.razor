@if (showBanner == true)
{
    <div class="banner hide-cursor-follow">
        <header class="hide-cursor-follow">
            This kit will only be accessible from this device
        </header>
        <p class="hide-cursor-follow">
            Please <a href="authentication/login" class="select-login">log in or create an account</a> to ensure changes are saved.
        </p>
        <span class="hide-cursor-follow" tabindex="0" @onclick="HideBanner" @onkeydown="EnterHideBanner">
            <img class="button--close hide-cursor-follow" src="images/close-icon.svg" />
        </span>
    </div>
}

@code {
    bool showBanner = true;
    //ElementReference? tabBanner;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // if (tabBanner.HasValue)
        //     await tabBanner.Value.FocusAsync();
        
            if (user.Identity.IsAuthenticated)
        {
            showBanner = false;
        }
    }

    void HideBanner() {
        showBanner = false;
    }

    void EnterHideBanner(KeyboardEventArgs e)
    {
        if (e.Code == "Enter")
        {
            showBanner = false;
        }
        
    }
}