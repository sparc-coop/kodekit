<div class="@Show">
    <div class="modal edit-name">
        <div class="overlay" @onclick="Close"></div>
        <div class="modal--container">
            <span class="material-icons button--close" @onclick="Close">close</span>
            <header>Edit Kit Name</header>
            <form>
                <input type="text" @bind-value="@Kit.Name" />
            </form>
            <button @onclick="UpdateKit" class="button--confirm">Save</button>
            <button @onclick="Close">Cancel</button>
        </div>
    </div>
</div>



@code {
    [Parameter]
    public string Show { get; set; }
    [Parameter]
    public EventCallback CloseModal { get; set; }
    [Parameter]
    public Kit Kit { get; set; }
    [Parameter]
    public string SelectedKit { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!String.IsNullOrEmpty(SelectedKit))
        {
            Kit = await PublicApi().GetKitAsync(SelectedKit);
        }
    }

    private async Task Close()
    {
        await CloseModal.InvokeAsync();
    }

    private async Task UpdateKit()
    {
        await PublicApi().UpdateKitAsync(new UpdateKitRequest { KitId = Kit.Id, Name = Kit.Name, IsAutoPublish = Kit.IsAutoPublish ?? false });
    }
}