@inherits LayoutComponentBase

<div class="layout--header simplified">
    <NavMenu transparent=true />
</div>

<div class="main no-sidebar">
    <div class="background">
        <div class="background-container">
            <div class="blob-container">
                <img class="blob-blue" src="blobs/blob-blue.svg" />
                <img class="blob-purple" src="blobs/blob-purple.svg" />
                <img class="blob-gradient" src="blobs/blob-gradient.svg" />
            </div>
            <img class="overlay-noise" src="blobs/noise-3.svg" />
        </div>
    </div>

    @Body
</div>